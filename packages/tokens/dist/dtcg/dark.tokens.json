{
  "$description": "OpenNavo Design Tokens, dark theme. Generated from tokens/tokens.json; do not edit.",
  "color": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "#0B0B0B",
        "$description": "Outer web and window background."
      },
      "base": {
        "$type": "color",
        "$value": "#131313",
        "$description": "Main content background."
      },
      "sidebar": {
        "$type": "color",
        "$value": "#161616",
        "$description": "Desktop sidebar."
      },
      "rail": {
        "$type": "color",
        "$value": "#141414",
        "$description": "Right rail with summaries and secondary actions."
      },
      "card": {
        "$type": "color",
        "$value": "#1A1A1A",
        "$description": "Cards."
      },
      "cardAlt": {
        "$type": "color",
        "$value": "#1F1F1F",
        "$description": "Inputs and secondary blocks within cards."
      },
      "raised": {
        "$type": "color",
        "$value": "#262626",
        "$description": "Hover, selection, icon tiles; darker than cards in light mode, so floating panels use popover."
      },
      "chip": {
        "$type": "color",
        "$value": "#2A2A2A",
        "$description": "Neutral badge background."
      },
      "control": {
        "$type": "color",
        "$value": "#2B2B2B",
        "$description": "Inputs, tooltips, and secondary controls."
      },
      "inset": {
        "$type": "color",
        "$value": "#111111",
        "$description": "Code blocks, logs, segmented-control tracks."
      },
      "overlay": {
        "$type": "color",
        "$value": "#1C1C1CEB",
        "$description": "Overlays with backdrop-filter: blur(20px)."
      },
      "popover": {
        "$type": "color",
        "$value": "#262626",
        "$description": "Floating panels and notices over content, such as consent and suggestion cards."
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#FFFFFF12",
        "$description": "Card borders and dividers."
      },
      "default": {
        "$type": "color",
        "$value": "#FFFFFF1F",
        "$description": "Input, ghost-button, and window borders."
      },
      "strong": {
        "$type": "color",
        "$value": "#FFFFFF33",
        "$description": "Hover borders."
      },
      "sidebar": {
        "$type": "color",
        "$value": "#1D1D1D",
        "$description": "Sidebar right border."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#EDEDED",
        "$description": "Headings, emphasized body text, numbers (14.9:1 on dark cards, 17.4:1 on light cards)."
      },
      "secondary": {
        "$type": "color",
        "$value": "#A8A8A8",
        "$description": "Body text and descriptions (7.3:1 on dark cards, 7.2:1 on light cards)."
      },
      "tertiary": {
        "$type": "color",
        "$value": "#8F8F8F",
        "$description": "Secondary information, labels, times (5.4:1 on dark cards, 4.7:1 on dark raised; 5.3:1 and 4.6:1 in light mode)."
      },
      "disabled": {
        "$type": "color",
        "$value": "#5C5C5C",
        "$description": "Disabled/decorative only; never convey essential information."
      },
      "inverse": {
        "$type": "color",
        "$value": "#141414",
        "$description": "Text and icons on solid fills (status, coral, salmon); dark in dark mode, white in light mode."
      },
      "onAccent": {
        "$type": "color",
        "$value": "#1B0A05",
        "$description": "Text on coral buttons/badges (7.2:1)."
      },
      "accent": {
        "$type": "color",
        "$value": "#FF7356",
        "$description": "Coral text, links, and icons; brand.coral is for fills and graphics (light mode needs a darker shade for 4.5:1)."
      }
    },
    "brand": {
      "coral": {
        "$type": "color",
        "$value": "#FF7356",
        "$description": "Primary brand color for fills and graphics: logo, progress, badges, emphasized buttons. For coral text use text.accent."
      },
      "salmon": {
        "$type": "color",
        "$value": "#F99E70",
        "$description": "Emphasized text: hero second line, badges, available updates."
      },
      "violet": {
        "$type": "color",
        "$value": "#5B5BD6",
        "$description": "Primary hero glow color."
      },
      "glowCore": {
        "$type": "color",
        "$value": "#CDCDFF",
        "$description": "Glow center highlight."
      },
      "logoGradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "#FFB347",
            "position": 0
          },
          {
            "color": "#FF7356",
            "position": 0.5
          },
          {
            "color": "#FF4E3A",
            "position": 1
          }
        ],
        "$description": "Logo N gradient, top-left to bottom-right."
      },
      "logoCoreGradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "#FFF6D6",
            "position": 0
          },
          {
            "color": "#FFC861",
            "position": 1
          }
        ],
        "$description": "Logo Polaris gradient on dark backgrounds."
      },
      "logoCoreGradientOnLight": {
        "$type": "gradient",
        "$value": [
          {
            "color": "#FFB347",
            "position": 0
          },
          {
            "color": "#FF8F3F",
            "position": 1
          }
        ],
        "$description": "Logo Polaris gradient on light backgrounds; warm white would disappear."
      }
    },
    "accent": {
      "coralSubtle": {
        "$type": "color",
        "$value": "#FF73561F",
        "$description": "Progress tracks and Updating badges."
      },
      "salmonSubtle": {
        "$type": "color",
        "$value": "#F99E701A",
        "$description": "Badge and available-update backgrounds."
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#3FCF6C",
        "$description": "Installed, success, current."
      },
      "successSubtle": {
        "$type": "color",
        "$value": "#3FCF6C1A"
      },
      "warning": {
        "$type": "color",
        "$value": "#FAB219",
        "$description": "Warnings and administrator permission required."
      },
      "warningSubtle": {
        "$type": "color",
        "$value": "#FAB2191A"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF5D51",
        "$description": "Failure, deprecated, delete."
      },
      "dangerSubtle": {
        "$type": "color",
        "$value": "#FF5D511A"
      },
      "info": {
        "$type": "color",
        "$value": "#66A4FA",
        "$description": "Self-updating, links, information."
      },
      "infoSubtle": {
        "$type": "color",
        "$value": "#66A4FA1A"
      },
      "successBorder": {
        "$type": "color",
        "$value": "#3FCF6C33",
        "$description": "Border of panels tinted with successSubtle."
      },
      "warningBorder": {
        "$type": "color",
        "$value": "#FAB21940",
        "$description": "Border of panels tinted with warningSubtle."
      },
      "dangerBorder": {
        "$type": "color",
        "$value": "#FF5D5140",
        "$description": "Border of panels tinted with dangerSubtle."
      },
      "infoBorder": {
        "$type": "color",
        "$value": "#66A4FA40",
        "$description": "Border of panels tinted with infoSubtle."
      }
    },
    "button": {
      "primaryBg": {
        "$type": "color",
        "$value": "#EBEBEB"
      },
      "primaryHover": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "primaryPressed": {
        "$type": "color",
        "$value": "#D6D6D6"
      },
      "primaryText": {
        "$type": "color",
        "$value": "#141414"
      },
      "secondaryBg": {
        "$type": "color",
        "$value": "#2B2B2B"
      },
      "secondaryHover": {
        "$type": "color",
        "$value": "#333333"
      },
      "secondaryPressed": {
        "$type": "color",
        "$value": "#242424"
      },
      "secondaryText": {
        "$type": "color",
        "$value": "#EDEDED"
      },
      "accentBg": {
        "$type": "color",
        "$value": "#FF7356"
      },
      "accentHover": {
        "$type": "color",
        "$value": "#FF8468"
      },
      "accentPressed": {
        "$type": "color",
        "$value": "#F0603F"
      },
      "accentText": {
        "$type": "color",
        "$value": "#1B0A05"
      },
      "disabledBg": {
        "$type": "color",
        "$value": "#171717"
      },
      "disabledText": {
        "$type": "color",
        "$value": "#5C5C5C"
      }
    },
    "chart": {
      "series1": {
        "$type": "color",
        "$value": "#7B72EE",
        "$description": "Category color 1, violet."
      },
      "series2": {
        "$type": "color",
        "$value": "#E0663F",
        "$description": "Category color 2, coral."
      },
      "series3": {
        "$type": "color",
        "$value": "#1E9E72",
        "$description": "Category color 3, cyan; all three checked for color-blind accessibility/contrast on #1A1A1A."
      },
      "emphasis": {
        "$type": "color",
        "$value": "#F99E70",
        "$description": "Single-series emphasis, current period."
      },
      "deemphasis": {
        "$type": "color",
        "$value": "#4A4A4A",
        "$description": "Single-series de-emphasis, historical period."
      },
      "grid": {
        "$type": "color",
        "$value": "#2C2C2A"
      },
      "axis": {
        "$type": "color",
        "$value": "#383838"
      }
    },
    "component": {
      "searchBg": {
        "$type": "color",
        "$value": "#1C1C1C",
        "$description": "Search-field and form-input background."
      },
      "cardHover": {
        "$type": "color",
        "$value": "#1D1D1D",
        "$description": "Interactive card hover background."
      },
      "toggleTrack": {
        "$type": "color",
        "$value": "#333333",
        "$description": "Off toggle track."
      },
      "toggleKnob": {
        "$type": "color",
        "$value": "#BDBDBD",
        "$description": "Off toggle thumb."
      },
      "toggleKnobOn": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "On toggle thumb."
      },
      "tabIndicator": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Selected-tab indicator."
      },
      "navActive": {
        "$type": "color",
        "$value": "#202020",
        "$description": "Selected sidebar navigation background."
      },
      "heroBg": {
        "$type": "color",
        "$value": "#0E0E10",
        "$description": "Featured hero card background."
      },
      "captionBg": {
        "$type": "color",
        "$value": "#0000008C",
        "$description": "Screenshot lower-left caption background; dark in both themes, so the caption renders in the dark theme (data-theme='dark')."
      },
      "topNavScrolled": {
        "$type": "color",
        "$value": "#0B0B0BD9",
        "$description": "Scrolled web navigation background: surface.page at 85% with backdrop-filter: blur(20px)."
      },
      "scrim": {
        "$type": "color",
        "$value": "#00000080",
        "$description": "Dialog/sheet backdrop."
      },
      "lightboxScrim": {
        "$type": "color",
        "$value": "#000000E0",
        "$description": "Screenshot lightbox backdrop; dark in both themes, so the lightbox renders in the dark theme (data-theme='dark')."
      },
      "modalBg": {
        "$type": "color",
        "$value": "#171717",
        "$description": "Dialog/sheet panel background."
      },
      "toastBg": {
        "$type": "color",
        "$value": "#2C2C2CEB",
        "$description": "Toast background with backdrop-filter: blur(20px)."
      },
      "itemActive": {
        "$type": "color",
        "$value": "#FFFFFF12",
        "$description": "Current menu/command-palette item background."
      },
      "runningBorder": {
        "$type": "color",
        "$value": "#FF735640",
        "$description": "Active-task card border, coral at 25%."
      },
      "logHeading": {
        "$type": "color",
        "$value": "#E8E8E8",
        "$description": "Log step lines beginning with ==>."
      },
      "logSuccess": {
        "$type": "color",
        "$value": "#7FD88F",
        "$description": "Successful log lines."
      },
      "monoText": {
        "$type": "color",
        "$value": "#D0D0D0",
        "$description": "Monospace table text, such as versions."
      },
      "timelineLine": {
        "$type": "color",
        "$value": "#333333",
        "$description": "Timeline line start, fading through surface.raised to transparent."
      },
      "timelineDot": {
        "$type": "color",
        "$value": "#3A3A3A",
        "$description": "Normal timeline entry dots."
      },
      "sourceMeta": {
        "$type": "color",
        "$value": "#555555",
        "$description": "Auxiliary-source dots, such as GitHub metadata in release sources."
      },
      "collectionFrom": {
        "$type": "color",
        "$value": "#1D1A26",
        "$description": "Collection card gradient start, 160°."
      },
      "collectionTo": {
        "$type": "color",
        "$value": "#161616",
        "$description": "Collection card gradient end at 70%."
      },
      "collectionRing": {
        "$type": "color",
        "$value": "#1B1922",
        "$description": "Collection stacked-icon border."
      },
      "detailHeaderBg": {
        "$type": "color",
        "$value": "#171717",
        "$description": "Detail header card background beneath glow."
      },
      "cliIconFrom": {
        "$type": "color",
        "$value": "#2A2A2A",
        "$description": "Command-line tile gradient start."
      },
      "cliIconTo": {
        "$type": "color",
        "$value": "#1B1B1B",
        "$description": "Command-line tile gradient end."
      },
      "cliIconText": {
        "$type": "color",
        "$value": "#E2E2E2",
        "$description": "Command-line tile text."
      },
      "letterIconText": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Letter-tile text, decorative because names always appear alongside."
      },
      "segmentActive": {
        "$type": "color",
        "$value": "#262626",
        "$description": "Selected segment of a segmented control."
      },
      "menuBarBg": {
        "$type": "color",
        "$value": "#262628F5",
        "$description": "In-app preview of the macOS menu bar strip."
      },
      "menuBarText": {
        "$type": "color",
        "$value": "#E6E6E6",
        "$description": "Menu bar preview items, drawn like AppKit template images."
      }
    },
    "macos": {
      "close": {
        "$type": "color",
        "$value": "#FF5F57"
      },
      "minimize": {
        "$type": "color",
        "$value": "#FEBC2E"
      },
      "zoom": {
        "$type": "color",
        "$value": "#28C840"
      }
    }
  },
  "shadow": {
    "window": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#000000A6",
          "offsetX": "0px",
          "offsetY": "50px",
          "blur": "140px",
          "spread": "0px"
        },
        {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        }
      ]
    },
    "popover": {
      "$type": "shadow",
      "$value": {
        "color": "#00000099",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "60px",
        "spread": "0px"
      }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "color": "#00000099",
        "offsetX": "0px",
        "offsetY": "30px",
        "blur": "80px",
        "spread": "0px"
      }
    },
    "toast": {
      "$type": "shadow",
      "$value": {
        "color": "#00000080",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "40px",
        "spread": "0px"
      }
    },
    "floatIcon": {
      "$type": "shadow",
      "$value": {
        "color": "#0000008C",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "30px",
        "spread": "0px"
      }
    },
    "appIcon": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#FFFFFF24",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px",
          "inset": true
        },
        {
          "color": "#00000066",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "iconText": {
      "$type": "shadow",
      "$value": {
        "color": "#0000004D",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "Letter-tile shadow preserves readability on light backgrounds."
    },
    "focusRing": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#131313",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#FF7356",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "4px"
        }
      ],
      "$description": "Keyboard focus ring: 2 px gap plus 2 px coral (3.5:1 against white in light mode)."
    },
    "segment": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Selected segment lift; none (a transparent shadow) in dark mode."
    },
    "knob": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Toggle knob lift; the white knob needs it on the light track."
    }
  },
